{
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git push:*)"
    ],
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Agent"
    ]
  },
  "autoMode": {
    "hard_deny": [
      "$defaults",
      "Never run `git push` in any form. Pushing to master deploys FuelTracker straight to production with no staging and no undo. The human runs the push themselves."
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"allow\",\"permissionDecisionReason\":\"plan auto-approved\"}}'",
            "statusMessage": "Auto-approving plan..."
          }
        ]
      }
    ]
  }
}
